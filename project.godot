; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section]
;   param=value
;

config_version=5

[application]
config/name="Breakfast VN"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.svg"

[autoload]
Game="*res://addons/vn_template/Game.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2

[input]
move_forward={"deadzone":0.5,"events":[{"type":"input_event_key","keycode":87}]}
move_backward={"deadzone":0.5,"events":[{"type":"input_event_key","keycode":83}]}
move_left={"deadzone":0.5,"events":[{"type":"input_event_key","keycode":65}]}
move_right={"deadzone":0.5,"events":[{"type":"input_event_key","keycode":68}]}
look_left={"deadzone":0.5,"events":[{"type":"input_event_mouse_motion"}]}
interact={"deadzone":0.5,"events":[{"type":"input_event_key","keycode":69}]}
open_inventory={"deadzone":0.5,"events":[{"type":"input_event_key","keycode":73}]}
open_journal={"deadzone":0.5,"events":[{"type":"input_event_key","keycode":74}]}
open_menu={"deadzone":0.5,"events":[{"type":"input_event_key","keycode":16777217}]}

[physics]
common/enable_pause_aware_picking=true
